<!-- post-container -->
<div class="post-container">

    <% articals.forEach((art, index)=> { %>
        <div class="post-content">
            <div class="row">
                <div class="col-md-4">
                    <a class="post-img" href="/single-artical/<%= art._id %>"><img src="images/<%= art.image %>" alt="" /></a>
                </div>
                <div class="col-md-8">
                    <div class="inner-content clearfix">
                        <h3><a href=''><%= art.title %></a></h3>
                        <div class="post-information">
                            <span>
                                <i class="fa fa-tags" aria-hidden="true"></i>
                                <a href='/category/<%=art._id%>'><%= art.category.name %></a>
                            </span>
                            <span>
                                <i class="fa fa-user" aria-hidden="true"></i>
                                <a href='author.html'><%= art.author.name %></a>
                            </span>
                            <span>
                                <i class="fa fa-calendar" aria-hidden="true"></i>
                                <td><%= new Date(art.timestamp).toLocaleDateString("en-GB") %></td>
                            </span>
                        </div>
                        <p class="description">
                            <%- art.description %>
                        </p>
                        <a class='read-more pull-right' href='/single-artical/<%= art._id %>'>read more</a>
                    </div>
                </div>
            </div>
        </div>
        <% }) %>



            <nav>
                <ul class="pagination">
                    <li class="page-item disabled">
                        <a class="page-link">Previous</a>
                    </li>
                    <li class="page-item"><a class="page-link" href="#">1</a></li>
                    <li class="page-item active">
                        <a class="page-link" href="#" aria-current="page">2</a>
                    </li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#">Next</a>
                    </li>
                </ul>
            </nav>
</div>
<!-- /post-container -->