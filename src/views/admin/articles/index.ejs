<div id="admin-content">
    <div class="container">
        <div class="row">
            <div class="col-md-10">
                <h1 class="admin-heading"><i class="fa fa-file-text"></i> All Articles</h1>
            </div>
            <div class="col-md-2">
                <a class="add-new" href="/admin/add-article-page">Add New Article</a>
            </div>
            <div class="col-md-12">
                <table class="content-table" style="background: white;">
                    <thead>
                        <th>S.No.</th>
                        <th>Title</th>
                        <th>Image</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Author</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </thead>
                    <tbody>
                        <% articals.forEach((art, index)=> { %>
                            <tr>
                                <td class='id'>
                                    <%= index + 1 %>
                                </td>
                                <td>
                                    <%= art.title %>
                                </td>
                                <td>
                                    <img src="/images/<%= art.image %>" alt="<%= art.category.name %>"
                                        width="80" height="60">
                                </td>
                                <td>
                                    <%= art.category.name %>
                                </td>
                                <td>
                                    <%= art.description %>
                                </td>
                                <td>
                                    <%= new Date(art.timestamp).toLocaleDateString("en-GB") %>
                                </td>
                                <td>
                                    <%= art.author.name %>
                                </td>
                                <td class='edit'><a href='/admin/update-article-page/<%= art._id %>'><i
                                            class='fa fa-edit'></i></a></td>
                                <td class='delete'><a href='/admin/delete-article/<%= art._id %>'><i
                                            class='fa fa-trash-o'></i></a></td>
                            </tr>
                            <%})%>

                    </tbody>
                </table>
                <nav aria-label="...">
                    <ul class="pagination">
                        <li class="page-item disabled">
                            <a class="page-link">Previous</a>
                        </li>
                        <li class="page-item"><a class="page-link" href="#">1</a></li>
                        <li class="page-item active">
                            <a class="page-link" href="#" aria-current="page">2</a>
                        </li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>